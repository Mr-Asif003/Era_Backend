# Copy this file to .env and fill in your real values.
# .env is already in .gitignore - never commit real credentials.

# MongoDB Atlas connection string. From Atlas: Database -> Connect ->
# "Connect your application" -> Driver: Java. It looks like:
#   mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# - URL-encode any special characters in the password (@, :, /, etc.)
#   e.g. "p@ss/word" -> "p%40ss%2Fword"
# - Include the database name in the path (eradb here) so you don't
#   depend on the separate `database:` default in application.yml.
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/eradb?retryWrites=true&w=majority

# Generate your own with: openssl rand -base64 32
JWT_SECRET=ZXJhX2p3dF9zZWNyZXRfbWluaW11bV8yNTZfYml0c19sb25nX2NoYW5nZV9pbl9wcm9k
